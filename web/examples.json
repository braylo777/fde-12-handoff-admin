{
  "stage": 12,
  "repo": "fde-12-handoff-admin",
  "title": "The Handoff & Self-Serve Admin",
  "tagline": "Make the FDE unnecessary: runbooks that run, a prompt/config portal with guardrails and rollback, chaos tests in the customer's VPC, and a go / no-go score for handoff.",
  "why": "A deployment is not done when it works; it is done when the customer's IT team can run it at 3 a.m. without calling you. That needs runbooks that are tested, a safe way for admins to change prompts and settings (with validation, approvals and one-click rollback), proof the system degrades gracefully when parts fail, and an honest checklist that says whether the handoff can happen.",
  "covers": [
    "Runbook lint: owner, verification check, rollback for mutating actions, dangling and unreachable steps",
    "Runbook execution against live observations: branch walk, loop guard, timeline, list of actions for the operator",
    "Config store: schema validation (types, ranges, allow-lists, length), credential detection, diff, two-person approval for risky keys, rollback, full history",
    "Chaos plan per component kind (LLM 429 / latency, vector DB down, pod kill, mid-workflow crash, expired credential, egress block) with blast radius and abort rules",
    "Chaos scoring: behaviour, alerting and recovery time; follow-up per failure",
    "Handoff readiness: weighted evidence checklist with blocking items"
  ],
  "gaps": [
    "Runbook actions are listed for the operator, not executed (no kubectl or cloud API calls)",
    "No chaos injection tooling (use Chaos Mesh, Litmus or AWS FIS to run the plan)",
    "The config store is a pure function over a version list; persist it in your DB or git"
  ],
  "ops": [
    {
      "op": "run_runbook",
      "label": "Run the runbook",
      "help": "Answers are failing. The provider is fine and retrieval is fast, but a config change went out an hour ago: the runbook leads to a rollback. Change the observations to walk other branches.",
      "input": {
        "runbook": {
          "name": "Agent answers are failing",
          "steps": [
            {
              "id": "s1",
              "title": "Is the LLM provider returning errors?",
              "owner": "IT on-call",
              "check": {
                "metric": "provider_5xx_rate",
                "op": ">",
                "value": 0.05
              },
              "on_pass": "s2",
              "on_fail": "s3"
            },
            {
              "id": "s2",
              "title": "Fail over to the backup model",
              "owner": "IT on-call",
              "action": "Set config model=backup via admin portal (failover)",
              "rollback": "Roll config back to previous version",
              "check": {
                "metric": "backup_error_rate",
                "op": "<",
                "value": 0.01
              },
              "on_pass": "done",
              "on_fail": "escalate"
            },
            {
              "id": "s3",
              "title": "Is retrieval slow?",
              "owner": "Platform team",
              "check": {
                "metric": "vector_p95_ms",
                "op": "<",
                "value": 400
              },
              "on_pass": "s5",
              "on_fail": "s4"
            },
            {
              "id": "s4",
              "title": "Restart vector DB replica",
              "owner": "Platform team",
              "action": "kubectl rollout restart statefulset/vectordb",
              "rollback": "none needed: stateless restart; data on PVC",
              "check": {
                "metric": "vector_p95_ms_after",
                "op": "<",
                "value": 400
              },
              "on_pass": "done",
              "on_fail": "escalate"
            },
            {
              "id": "s5",
              "title": "Did a config change go out in the last hour?",
              "owner": "IT on-call",
              "check": {
                "metric": "config_changed_last_hour",
                "op": "==",
                "value": true
              },
              "on_pass": "s6",
              "on_fail": "escalate"
            },
            {
              "id": "s6",
              "title": "Roll back the last config change",
              "owner": "IT on-call",
              "action": "Admin portal: rollback to previous version",
              "rollback": "Re-apply the reverted version",
              "check": {
                "metric": "eval_pass_rate",
                "op": ">=",
                "value": 0.9
              },
              "on_pass": "done",
              "on_fail": "escalate"
            }
          ]
        },
        "observations": {
          "provider_5xx_rate": 0.004,
          "vector_p95_ms": 180,
          "config_changed_last_hour": true,
          "eval_pass_rate": 0.94
        }
      }
    },
    {
      "op": "lint_runbook",
      "label": "Lint a bad runbook",
      "help": "The same runbook after careless edits: a restart with no rollback, a branch to a step that does not exist, an orphaned step and a step with no owner.",
