    {
      "op": "config_change",
      "label": "Admin changes config",
      "help": "A customer admin switches the model and edits the prompt. Both are risky keys, so a second person must approve. Remove approved_by to see it refused, or set temperature to 1.5.",
      "input": {
        "schema": {
          "risky_keys": [
            "model",
            "system_prompt"
          ],
          "fields": {
            "model": {
              "type": "string",
              "required": true,
              "one_of": [
                "claude-sonnet-5-5",
                "claude-haiku-5-5",
                "onprem-llama-70b"
              ]
            },
            "temperature": {
              "type": "number",
              "min": 0,
              "max": 1
            },
            "system_prompt": {
              "type": "string",
              "required": true,
              "max_len": 600
            },
            "greeting": {
              "type": "string",
              "max_len": 80
            },
            "max_refund_without_approval": {
              "type": "number",
              "min": 0,
              "max": 500
            },
            "show_citations": {
              "type": "bool"
            }
          }
        },
        "history": [
          {
            "version": 1,
            "author": "fde@vendor",
